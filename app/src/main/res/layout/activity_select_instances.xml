<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selecciona_las_instancias_que_deseas_usar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Misskey -->
        <CheckBox
            android:id="@+id/checkMisskey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misskey" />

        <EditText
            android:id="@+id/editMisskeyInstance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL de la instancia de Misskey"
            android:inputType="textUri"
            android:visibility="gone" />

        <!-- Mastodon -->
        <CheckBox
            android:id="@+id/checkMastodon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mastodon"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editMastodonInstance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL de la instancia de Mastodon"
            android:inputType="textUri"
            android:visibility="gone" />

        <!-- Bluesky -->
        <CheckBox
            android:id="@+id/checkBluesky"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bluesky"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editBlueskyInstance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dominio de Bluesky (ej. bsky.social)"
            android:inputType="textUri"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGuardarInstancias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>