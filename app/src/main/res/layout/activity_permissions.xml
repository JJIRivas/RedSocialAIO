<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permisos requeridos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permisos del dispositivo (Android):"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Acceder a la cámara (para subir fotos)\n• Acceder al almacenamiento (para guardar o subir archivos)\n• Acceso a internet (para conectar con las redes sociales)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permisos al iniciar sesión en redes sociales:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Misskey:"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Leer publicaciones\n• Publicar en tu nombre\n• Acceder a información del perfil" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mastodon:"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Leer timeline\n• Publicar en tu nombre\n• Ver seguidores y seguir cuentas" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bluesky:"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Leer timeline\n• Crear posts\n• Acceder a tu identidad descentralizada (DID)" />
        <CheckBox
            android:id="@+id/checkPermisosAceptados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="He leido y acepto los permisos anteriores"
            android:layout_marginTop="16dp"/>


        <Button
            android:id="@+id/btnContinuarLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aceptar y continuar"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>