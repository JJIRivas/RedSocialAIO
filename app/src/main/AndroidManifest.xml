<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedSocialAIO"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RedSocialAIO">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".misskey.userInfo.MisskeyCallbackActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="redsocialaio"
                    android:host="misskey"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.Unified.UnifiedTimeline" />
        <activity android:name=".mastodon.MastodonCallbackActivity" />
        <activity android:name=".core.checkers.InstancePickerActivity" />
        <activity android:name=".core.checkers.InstanceValidation" />
        <activity android:name=".ui.MissUI" />
        <activity android:name=".firebase.auth.AccountCreation" />
        <activity android:name=".firebase.auth.AccountRecovery" />
        <activity android:name=".firebase.auth.AccountLogin" />
        <activity android:name=".misskey.validation.MisskeyInstanceInput" />
    </application>

</manifest>